    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "jsdoc": "^4.0.5",
    "semver": "^7.8.5",
    "shiki": "^4.3.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
