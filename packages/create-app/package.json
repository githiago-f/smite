{
  "name": "create-smite-app",
  "version": "2.0.0-SNAPSHOT",
  "description": "Scaffold a new Smite application from the command line.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/githiago-f/smite.git"
  },
  "homepage": "https://github.com/githiago-f/smite#readme",
  "bugs": {
    "url": "https://github.com/githiago-f/smite/issues"
  },
  "type": "module",
  "bin": {
    "create-smite-app": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@smitejs/cli": "^2.0.0-SNAPSHOT",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "sideEffects": false
}
