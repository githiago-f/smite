{
  "name": "create-smite-app",
  "version": "1.2.1",
  "description": "Scaffold a new Smite application from the command line.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-smite-app": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@smitejs/cli": "^1.2.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "sideEffects": false
}
