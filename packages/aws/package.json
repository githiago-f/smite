{
  "name": "@smitejs/aws",
  "version": "2.0.0-SNAPSHOT",
  "description": "AWS resource declarations, injected clients, and permission metadata for Smite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/githiago-f/smite.git"
  },
  "homepage": "https://github.com/githiago-f/smite#readme",
  "bugs": {
    "url": "https://github.com/githiago-f/smite/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:floci": "SMITE_FLOCI=1 vitest run src/floci.integration.test.ts"
  },
  "dependencies": {
    "@smitejs/core": "^2.0.0-SNAPSHOT"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1102.0",
    "@aws-sdk/client-eventbridge": "^3.1102.0",
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/client-sqs": "^3.1102.0",
    "@aws-sdk/client-ssm": "^3.1102.0",
    "testcontainers": "^12.1.0"
  },
  "sideEffects": false
}
