{
  "name": "@smite/http",
  "version": "0.1.1",
  "description": "HTTP semantics for Smite: apps, routes, endpoints and the serve executor.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
