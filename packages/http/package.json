    "test": "vitest run"
  },
  "dependencies": {
    "@smite/core": "*",
    "@smite/fp": "*",
    "path-to-regexp": "^8.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "sideEffects": false
}
