{
  "name": "@smitejs/env",
  "version": "1.2.0",
  "description": "Declarative environment variables for Smite: provider, zod validation, collect-mode manifest.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@smitejs/core": "^1.2.0",
    "zod": "^4.0.0"
  },
  "sideEffects": false
}
