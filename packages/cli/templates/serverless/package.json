{
  "name": "{{name}}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "smite build",
    "deploy": "smite deploy serverless",
    "offline": "serverless offline start --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "dependencies": {
    "@smitejs/http": "latest",
    "@smitejs/serverless": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@smitejs/cli": "latest",
    "@types/node": "^22.10.0",
    "serverless": "^4.7.0",
    "serverless-offline": "^14.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
