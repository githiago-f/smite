{
  "name": "@smitejs/runtime-express",
  "version": "0.1.0",
  "description": "Express runtime emitter for Smite descriptors.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "sideEffects": false,
  "dependencies": {
    "@smitejs/core": "0.1.0"
  }
}
