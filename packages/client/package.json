{
  "name": "@smitejs/client",
  "version": "2.0.0-SNAPSHOT",
  "description": "Generates a typed, builder-style HTTP client from a Smite app definition.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/githiago-f/smite.git"
  },
  "homepage": "https://github.com/githiago-f/smite#readme",
  "bugs": {
    "url": "https://github.com/githiago-f/smite/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@smitejs/cli": "^2.0.0-SNAPSHOT",
    "@smitejs/core": "^2.0.0-SNAPSHOT",
    "esbuild": "^0.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "sideEffects": false
}
