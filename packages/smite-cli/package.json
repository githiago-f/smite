{
  "name": "smite-cli",
  "version": "2.0.0-SNAPSHOT",
  "description": "Command-line entrypoint for the Smite framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/githiago-f/smite.git"
  },
  "homepage": "https://github.com/githiago-f/smite#readme",
  "bugs": {
    "url": "https://github.com/githiago-f/smite/issues"
  },
  "type": "module",
  "bin": {
    "smite": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@smitejs/cli": "^2.0.0-SNAPSHOT"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "sideEffects": false
}
