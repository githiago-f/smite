{
  "name": "@smite/openapi",
  "version": "1.0.0",
  "description": "OpenAPI 3.1 artifact generator for Smite apps, delivered as an @smite/cli plugin.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@smite/cli": "^1.0.0",
    "@smite/core": "^1.0.0",
    "@smite/http": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "sideEffects": false
}
