{
  "name": "@smitejs/openapi",
  "version": "1.2.0",
  "description": "OpenAPI 3.1 artifact generator for Smite apps, delivered as an @smitejs/cli plugin.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@smitejs/cli": "^1.2.0",
    "@smitejs/core": "^1.2.0",
    "@smitejs/http": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "sideEffects": false
}
