{
  "name": "@smitejs/openapi",
  "version": "2.0.0-SNAPSHOT",
  "description": "OpenAPI 3.1 artifact generator for Smite apps, delivered as an @smitejs/cli plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/githiago-f/smite.git"
  },
  "homepage": "https://github.com/githiago-f/smite#readme",
  "bugs": {
    "url": "https://github.com/githiago-f/smite/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/.tsbuildinfo"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@smitejs/cli": "^2.0.0-SNAPSHOT",
    "@smitejs/core": "^2.0.0-SNAPSHOT",
    "@smitejs/http": "^2.0.0-SNAPSHOT"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "sideEffects": false
}
